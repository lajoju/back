            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Funcionário Postman\",\n  \"email\": \"funcionario.{{clienteEmail}}\",\n  \"password\": \"{{senha}}\",\n  \"flgFuncionario\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{usuarioUrl}}/usuarios",
              "host": [
                "{{usuarioUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Atualizar funcionário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Funcionário Postman Atualizado\",\n  \"email\": \"funcionario.{{clienteEmail}}\",\n  \"password\": \"{{senha}}\",\n  \"flgFuncionario\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{usuarioUrl}}/usuarios/{{funcionarioId}}",
              "host": [
                "{{usuarioUrl}}"
              ],
              "path": [
                "usuarios",
                "{{funcionarioId}}"
              ]
            }
          }
        }
      ]
    },
